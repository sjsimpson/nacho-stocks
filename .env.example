# Postgres. Local: `docker compose up -d`. Prod: Neon via Vercel Marketplace.
DATABASE_URL=postgres://nacho:nacho@localhost:5432/nacho_stocks

# BetterAuth. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Market data. https://eulerpool.com/developers
EULERPOOL_API_KEY=

# Email (Resend). Optional locally: without a key, emails print to the dev server log.
RESEND_API_KEY=
EMAIL_FROM=Nacho Stocks <hello@nachostocks.com>

# Comma-separated. These accounts become admins once their email is verified.
# Local shortcut without email: `pnpm admin:grant <username|email>`.
ADMIN_EMAILS=

# Cache. Optional locally (falls back to in-memory). Prod: Upstash via Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest. Locally set INNGEST_DEV=1 and run `pnpm inngest:dev`. Prod: Inngest via Vercel Marketplace.
INNGEST_DEV=1
# Port 8388 avoids clashing with other local Inngest dev servers on 8288.
INNGEST_BASE_URL=http://localhost:8388
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
