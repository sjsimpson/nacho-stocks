# Postgres. Local: `docker compose up -d`. Prod: Neon via Vercel Marketplace.
DATABASE_URL=postgres://nacho:nacho@localhost:5432/nacho_stocks

# BetterAuth. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Market data. https://eulerpool.com/developers
EULERPOOL_API_KEY=

# Cache. Optional locally (falls back to in-memory). Prod: Upstash via Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest. Not needed locally with `pnpm inngest:dev`. Prod: Inngest via Vercel Marketplace.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
